# Copy to .env and fill in. Never commit .env.
# Every variable is optional except the first three.

# --- Required -----------------------------------------------------------------
# Token from @BotFather
KEST_TELEGRAM_TOKEN=
# Your numeric Telegram user ID (several allowed, comma separated). Ask @userinfobot.
KEST_OWNER_ID=
# Key from https://openrouter.ai/keys
KEST_OPENROUTER_API_KEY=

# --- General ------------------------------------------------------------------
# IANA timezone used for every schedule
KEST_TIMEZONE=UTC
# Where the database, config.toml and backups live
KEST_DATA_DIR=./data
# Alternative path to config.toml (default: <data dir>/config.toml)
# KEST_CONFIG=

# --- Logging ------------------------------------------------------------------
# debug | info | warn | error
KEST_LOG_LEVEL=info
# text | json
# KEST_LOG_FORMAT=text
# Allow message content in debug logs. Leave off unless you are debugging.
# KEST_LOG_SENSITIVE=false

# --- Models (OpenRouter slugs; check https://openrouter.ai/models) ------------
KEST_MODEL_GENERAL=google/gemini-3-flash-preview
# Comma separated fallbacks tried in order
# KEST_MODEL_FALLBACKS=
KEST_MODEL_TRANSCRIPTION=openai/gpt-4o-mini-transcribe
KEST_MODEL_TTS=openai/gpt-4o-mini-tts-2025-12-15
KEST_TTS_VOICE=alloy
# KEST_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Only route to zero-data-retention providers where supported
# KEST_ZDR_ONLY=false

# --- Budget and coaching ------------------------------------------------------
# Daily spend limit in USD; 0 disables
KEST_DAILY_BUDGET_USD=1.00
# Most unsolicited messages per day (0 to 20)
KEST_MAX_PROACTIVE_PER_DAY=3
# Local quiet hours used until the sleep model has enough data
# KEST_QUIET_START=23:00
# KEST_QUIET_END=07:00
